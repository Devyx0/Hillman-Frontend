# Copy to .env.local (git-ignored) to run against the Hillman Centrale API.
# Leave unset to run the in-memory demo instead.

# Hillman Centrale API (Hillman-Backend). Its CORS_ORIGINS must include this app's origin.
VITE_API_URL=http://localhost:3000
# Supabase project used by the API for sign-in (dashboard → Project Settings → API keys).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (public by design; never the secret key).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
